# Configuration for Instagram Scraper

# Option 1: Official Meta Graph API Credentials
# Required for InstagramGraphAPIScraper
# Obtain from Facebook Developer Portal (https://developers.facebook.com/)
INSTAGRAM_ACCESS_TOKEN=your_facebook_user_or_page_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
GRAPH_API_VERSION=v19.0

# Option 2: Instaloader Credentials (Optional, for private/session fallback)
INSTAGRAM_USERNAME=your_ig_username_here
INSTAGRAM_PASSWORD=your_ig_password_here
